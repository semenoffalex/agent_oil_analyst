# Chat — Main slot (ADR 0023). Required. No silent DeepSeek/Grok fallback.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MAIN_CHAT_MODEL=z-ai/glm-5.2:free
OUROBOROS_MODEL=z-ai/glm-5.2:free
# Unset Heavy / Light / Eval / skill-review → Main.
OUROBOROS_MODEL_HEAVY=
OUROBOROS_MODEL_LIGHT=
OUROBOROS_MODEL_FALLBACKS=
OUROBOROS_REVIEW_MODELS=
EVAL_CHAT_MODEL=

# Chainlit adapter → Ouroboros gateway (compose sets http://ouroboros:8765)
OUROBOROS_URL=http://127.0.0.1:8765
OUROBOROS_TURN_TIMEOUT_SEC=900

# Demo harness (ADR 0024). Compose also pins these.
OUROBOROS_RUNTIME_MODE=light
OUROBOROS_TASK_REVIEW_MODE=off
OUROBOROS_POST_TASK_EVOLUTION=false
OUROBOROS_EFFORT_TASK=none
OUROBOROS_RETURN_REASONING=false

# UI
CHAINLIT_HOST=0.0.0.0
CHAINLIT_PORT=8000

# Demo rate limit (ADR 0017). 0 = disabled (local dev).
DEMO_RATE_LIMIT_MAX=0
DEMO_RATE_LIMIT_WINDOW_SEC=3600

# Retrieval — OpenRouter embeddings (ADR 0025). Reuses OPENROUTER_API_KEY when EMBEDDING_API_KEY is unset.
CHROMA_PATH=./data/chroma
SAMPLES_PATH=./data/samples
REPORTS_PATH=./data/reports
RETRIEVE_K=10
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free

# Forecast
YFINANCE_DEFAULT_SYMBOL=BZ=F
YFINANCE_WTI_SYMBOL=CL=F

# LangSmith (leave API key empty to disable). Never commit the key.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=pr-drab-realization-91
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=pr-drab-realization-91
