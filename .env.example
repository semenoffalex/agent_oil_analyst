# Chat
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Must be 0. Omitting this turns vendor thinking mode back on (ADR 0006).
DEEPSEEK_THINKING=0

# UI
CHAINLIT_HOST=0.0.0.0
CHAINLIT_PORT=8000

# Retrieval
CHROMA_PATH=./data/chroma
SAMPLES_PATH=./data/samples
REPORTS_PATH=./data/reports
RETRIEVE_K=5
EMBEDDING_MODEL=intfloat/multilingual-e5-base
# OpenAI-compatible embeddings (LM Studio). Empty = local SentenceTransformer.
# EMBEDDING_BASE_URL=http://192.168.0.55:1234/v1
# EMBEDDING_MODEL=text-embedding-multilingual-e5-base
# EMBEDDING_API_KEY=lm-studio
# Optional local Hugging Face cache (Docker image already bakes /opt/hf-cache).
# HF_HOME=
# HF_HUB_OFFLINE=0

# Forecast
YFINANCE_DEFAULT_SYMBOL=BZ=F
YFINANCE_WTI_SYMBOL=CL=F
