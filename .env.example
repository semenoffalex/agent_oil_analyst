# Chat
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Must be 0. Omitting this turns vendor thinking mode back on (ADR 0006).
DEEPSEEK_THINKING=0

# UI
CHAINLIT_HOST=0.0.0.0
CHAINLIT_PORT=8000

# Retrieval
CHROMA_PATH=./data/chroma
SAMPLES_PATH=./data/samples
REPORTS_PATH=./data/reports
RETRIEVE_K=5
EMBEDDING_MODEL=intfloat/multilingual-e5-base
# OpenAI-compatible embeddings (LM Studio). Empty = local SentenceTransformer.
# Docker Compose uses host.docker.internal; if LM Studio is down the app falls
# back to EMBEDDING_LOCAL_MODEL (baked e5 in the image).
# EMBEDDING_BASE_URL=http://host.docker.internal:1234/v1
# EMBEDDING_MODEL=text-embedding-multilingual-e5-base
# EMBEDDING_API_KEY=lm-studio
# EMBEDDING_LOCAL_MODEL=/opt/models/multilingual-e5-base
# Optional local Hugging Face cache (Docker image already bakes /opt/hf-cache).
# HF_HOME=
# HF_HUB_OFFLINE=0

# Forecast
YFINANCE_DEFAULT_SYMBOL=BZ=F
YFINANCE_WTI_SYMBOL=CL=F
